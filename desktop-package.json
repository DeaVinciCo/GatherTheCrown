{
  "name": "gather-the-crown",
  "version": "1.0.0",
  "description": "Cross-platform multiplayer RPG",
  "author": "Game Dev Team",
  "license": "MIT",
  "main": "dist/electron/main.js",
  "homepage": "./",
  "scripts": {
    "monorepo:install": "pnpm install",
    "monorepo:build": "pnpm -r build",
    "monorepo:dev": "pnpm --parallel -r dev",
    "web:dev": "pnpm --filter=@game/client run dev",
    "web:build": "pnpm --filter=@game/client run build",
    "server:dev": "pnpm --filter=@game/server run dev",
    "server:build": "pnpm --filter=@game/server run build",
    "server:start": "pnpm --filter=@game/server run start",
    "build:all": "npm run web:build && npm run server:build",
    "build:desktop": "npm run web:build && electron-builder --win --mac --linux",
    "build:mobile": "expo build",
    "pack:desktop": "electron-builder --publish=always",
    "pack:ios": "expo build:ios",
    "pack:android": "expo build:android",
    "deploy:web": "npm run web:build",
    "deploy:desktop": "npm run build:desktop && npm run pack:desktop",
    "deploy:mobile": "npm run build:mobile && npm run pack:ios && npm run pack:android",
    "deploy:all": "npm run deploy:web && npm run deploy:desktop && npm run deploy:mobile",
    "start:desktop": "electron .",
    "start:web": "pnpm --filter=@game/client run start"
  },
  "build": {
    "appId": "com.DeaVinciCo.gatherthecrown",
    "productName": "Gather The Crown",
    "directories": {
      "buildResources": "assets/desktop"
    },
    "files": [
      "dist/electron/**/*",
      "packages/client/dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "certificateFile": null,
      "certificatePassword": null,
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "electron": "^latest",
    "electron-builder": "^latest"
  }
}
