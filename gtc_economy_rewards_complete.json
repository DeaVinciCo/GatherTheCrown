    "potion_hybrid": {
      "duration_sec": "20-30",
      "cooldown_sec": 120,
      "boss_story_only": true,
      "effect": "Temporarily grants secondary elemental kit at 60% potency",
      "visual": "+25% attack, +15% speed, -20% damage taken, unique skill tree access"
    }
  },
  
  "account_rules": {
    "max_characters": 3,
    "max_creats_per_character": 3,
    "total_creats_per_account": 9,
    "first_creat_rule": "Cannot be traded, deleted, or replaced. To remove it, must delete entire account",
