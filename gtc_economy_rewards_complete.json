        "wear_down_time_sec": 90,
        "on_shatter": "pieces fall, pulse for 8 seconds, then disappear; cannot be recovered"
      }
    },
    "metals": ["bronze","silver","gold","bixbite_core","osmium","aethersteel","starforged"],
    "gems": ["quartz","topaz","sapphire","spinel","alexandrite","jeremejevite","painite","bixbite"],
    "visual_rule": "Shards MUST look like the material (bronze=dull brownish-orange, gold=bright shiny yellow, obsidian=black glass-like)",
    "completion_rewards": ["gold_bundle","gems_bundle","shards_bundle","bixbite_small","blueprints","titles","stat_boost_mode_specific"]
  },
  
  "currencies": {
    "types": ["gold_coins","gems","shards","bixbite"],
    "gems_value_order": ["clear(light/storm)","yellow(gold)","green(earth)","blue(water)","red(fire)","purple(shadow)","cosmic(arcane)"],
    "gem_values_gc": {
      "yellow_gold": 700,
      "red_fire": 500,
      "green_earth": 400,
      "blue_water": 350,
      "clear_light": 300,
      "purple_shadow": 250,
      "black_void": "3000-5000"
    },
    "sell_examples": {
      "4_red_fire_gems": "2000_gc",
      "10_red_fire_gems": "6000_gc (bulk bonus)",
      "note": "Bulk sells give diminishing bonus to prevent hoard exploits"
    }
  },
  
  "creat_bonding": {
    "bond_levels": [
      {"pct":50, "mana_slots":5, "effects":["+5% dmg","+5% speed"], "sync_move":"basic_combo", "flow_efficiency":"slower_absorption_longer_cooldown"},
      {"pct":75, "mana_slots":7, "effects":["+10% dmg","+10% resist"], "sync_move":"advanced_combo", "flow_efficiency":"faster_absorption_shorter_cooldown"},
      {"pct":100, "mana_slots":10, "effects":["+15% dmg","+15% resist","+1 utility slot (non-race)"], "sync_move":"ultimate_combo", "flow_efficiency":"near_seamless_flow_increased_potency"}
    ],
    "gain_sources": ["battles","feeding","petting","quests","time_together"],
    "decay_rule": {"idle_days":7,"decay_to_pct":75}
