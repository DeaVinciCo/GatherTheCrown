{
  "module": "gtc_save_load_system",
  "version": "1.0",
  "game": "Gather The Crown: Creats & Foes",
  
  "storage_strategy": {
    "phase_1_local": {
      "format": "JSON",
      "location": "user_documents/GTC_Saves/",
      "filename_pattern": "save_{username}_{slot}.json",
      "auto_save_triggers": [
        "quest_complete",
        "boss_defeated",
        "chest_opened",
        "crown_forged",
        "home_base_upgrade",
        "every_5_minutes"
      ],
      "manual_save_locations": ["home_base", "safe_zones", "pause_menu"]
    },
    "phase_2_cloud": {
      "backend": "supabase_or_firebase",
      "sync_triggers": ["manual_save", "session_end", "every_15_minutes"],
      "conflict_resolution": "server_timestamp_wins",
      "offline_mode": "queue_changes_sync_when_online"
    }
  },
  
  "save_file_structure": {
    "account": {
      "username": "string (unique, 3-20 chars)",
      "display_name": "string (changeable)",
      "email": "string (optional for phase 1)",
      "created_at": "timestamp",
      "last_login": "timestamp",
      "total_playtime_hours": 0,
      "account_level": 1,
      "faction": "null or faction_id",
      "chat_color_main": "blue",
      "chat_color_faction": "indigo",
      "settings": {
        "music_volume": 0.7,
        "sfx_volume": 0.8,
        "camera_zoom": 1.25,
        "show_damage_numbers": true,
        "auto_loot": false
      }
    },
    
    "currency": {
      "gold_coins": 0,
      "gems_total": 0,
      "shards_total": 0,
      "bixbite": 0
    },
    
    "characters": [
      {
        "slot": 1,
        "name": "string",
        "element": "fire|water|earth|storm|light|shadow|arcane",
        "born_hybrid": false,
        "hybrid_elements": [],
        "level": 1,
        "xp": 0,
        "xp_to_next_level": 1000,
        
        "stats": {
          "hp_max": 100,
          "hp_current": 100,
          "stamina_max": 100,
          "stamina_current": 100,
          "hunger": 100,
          "mana_max": 100,
          "mana_current": 100,
          "attack": 10,
          "defense": 10,
          "speed": 10
        },
        
        "equipped": {
          "weapon_main": "wpn_sword_light",
          "weapon_secondary": null,
          "armor_head": null,
          "armor_chest": "cloth_tunic",
          "armor_legs": "cloth_pants",
          "armor_feet": "leather_boots",
          "accessory_1": null,
          "accessory_2": null,
          "crown": null
        },
        
        "attack_loadout": {
          "trait_slot_locked": "trait_fire_brand",
          "attack_slot_1": "atk_fire_bolt",
          "attack_slot_2": "atk_cinder_dash",
          "utility_slot_1": "atk_bark_skin",
          "utility_slot_2": null
        },
        
        "inventory": {
          "max_slots": 50,
          "items": [
            {"id": "wpn_bow_wood", "quantity": 1, "durability": 100},
            {"id": "potion_health_small", "quantity": 5},
            {"id": "food_apple", "quantity": 12}
