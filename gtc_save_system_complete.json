    "leaderboards": {
      "race_mode_best_time": null,
      "pvp_mmr": 1000,
      "faction_contribution": 0
    }
  },
  
  "save_operations": {
    "create_new_save": {
      "action": "Initialize new save file with default values",
      "username_check": "Must be unique",
      "first_character_setup": "Prompt for name, element, appearance",
      "first_creat_setup": "Hatch first creat (permanent, cannot delete)"
    },
    
    "auto_save": {
      "frequency": "Every 5 minutes or on trigger events",
      "backup_previous": true,
      "max_backups": 3,
      "notification": "Auto-saved (small icon flash)"
    },
    
    "manual_save": {
      "locations": ["home_base", "safe_zones", "pause_menu"],
      "confirmation": "Game saved successfully",
      "cloud_sync": "If online, push to server"
    },
    
    "load_save": {
      "on_startup": "Load most recent save for username",
      "character_select": "If multiple characters, show selection screen",
      "integrity_check": "Verify save file not corrupted",
      "fallback": "Load most recent backup if main save corrupted"
    },
    
    "delete_character": {
      "requirements": [
        "Cannot delete first creat (must delete entire account)",
        "Confirmation dialog with warning",
        "All items/progress for that character lost"
      ]
    },
    
    "delete_account": {
      "requirements": [
        "Must have 50,000,000 GC",
        "Story mode completed at least once",
        "Triple confirmation dialog",
        "All characters, creats, progress deleted permanently"
      ],
      "cost": 50000000,
      "irreversible": true
    }
  },
  
  "cloud_sync_schema": {
    "tables": {
      "users": {
        "id": "uuid PRIMARY KEY",
        "username": "varchar(20) UNIQUE",
        "email": "varchar(255)",
        "password_hash": "varchar(255)",
        "created_at": "timestamp",
        "last_login": "timestamp"
      },
      
      "characters": {
        "id": "uuid PRIMARY KEY",
        "user_id": "uuid FOREIGN KEY",
        "slot": "integer (1-3)",
        "name": "varchar(50)",
        "element": "varchar(20)",
        "level": "integer",
        "xp": "integer",
        "stats": "jsonb",
        "inventory": "jsonb",
        "progress": "jsonb",
        "updated_at": "timestamp"
      },
      
      "creats": {
        "id": "uuid PRIMARY KEY",
        "character_id": "uuid FOREIGN KEY",
        "slot": "integer (1-3)",
        "is_first_creat": "boolean",
        "name": "varchar(50)",
        "species": "varchar(50)",
        "bond_percent": "integer",
        "stats": "jsonb",
        "updated_at": "timestamp"
      },
      
      "crown_progress": {
        "id": "uuid PRIMARY KEY",
        "character_id": "uuid FOREIGN KEY",
        "crown_id": "varchar(50)",
        "slots": "jsonb",
        "complete": "boolean",
        "updated_at": "timestamp"
      },
      
      "match_history": {
        "id": "uuid PRIMARY KEY",
        "user_id": "uuid FOREIGN KEY",
        "mode": "varchar(50)",
        "result": "jsonb",
        "rewards": "jsonb",
        "created_at": "timestamp"
      },
      
      "leaderboards": {
        "id": "uuid PRIMARY KEY",
        "user_id": "uuid FOREIGN KEY",
        "mode": "varchar(50)",
        "score": "integer",
        "season": "varchar(20)",
        "rank": "integer",
        "updated_at": "timestamp"
      }
    },
    
    "row_level_security": {
      "enabled": true,
      "policy": "Users can only read/write their own data (user_id = auth.uid())"
    }
  },
  
  "anti_cheat": {
    "server_validation": [
      "Currency changes (gold, gems, shards, bixbite)",
      "XP gains and level ups",
      "Crown completion rewards",
      "Match results and leaderboard scores",
      "Boss defeat rewards"
    ],
    "client_only": [
      "Movement and camera",
      "UI interactions",
      "Visual effects"
    ],
    "checksums": {
      "save_file_hash": "SHA-256 of critical data",
      "verify_on_load": true,
      "detect_tampering": "Reject save if hash mismatch"
    }
  },
  
  "backup_strategy": {
    "local_backups": {
      "frequency": "Every auto-save",
      "keep_last": 3,
      "location": "user_documents/GTC_Saves/backups/"
    },
    "cloud_backups": {
      "frequency": "Daily",
      "retention": "14 days",
      "location": "cloud_storage/backups/"
    }
  },
  
  "migration_path": {
    "v1_to_v2": {
      "description": "When adding new features, migrate old saves",
      "add_defaults": "New fields get default values",
      "preserve_progress": "Never lose player progress",
      "version_tag": "Each save has version number"
    }
  }
}
