    "unlocks": {
      "multi_character_unlocked": false,
      "character_slots_available": 1,
      "max_character_slots": 3,
      "story_mode_completed_once": false
    },
    
    "statistics": {
      "total_battles": 0,
      "total_races": 0,
      "total_pvp_matches": 0,
      "total_bosses_defeated": 0,
      "total_crowns_forged": 0,
      "total_gold_earned": 0,
      "total_deaths": 0,
      "favorite_mode": null
