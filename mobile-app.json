{
  "expo": {
    "name": "Gather The Crown",
    "slug": "gather-the-crown",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.DeaVinciCo.gatherthecrown",
      "buildNumber": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.DeaVinciCo.gatherthecrown",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "description": "Cross-platform multiplayer RPG - Battle creatures, complete quests, and build your legend.",
    "author": "Game Dev Team",
    "license": "MIT",
    "platforms": [
      "ios",
      "android",
      "web"
    ]
  }
}
