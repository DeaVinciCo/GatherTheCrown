# Client environment variables
# Copy this file to .env.local and fill in your Supabase project values.
# Never commit .env.local to version control.

# Server API
VITE_API_URL=http://localhost:2567

# Supabase project URL (found in Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (safe to expose in client-side code)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
