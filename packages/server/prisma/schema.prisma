generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Account {
  id       String  @id @default(cuid())
  email    String  @unique
  heroes   Hero[]
}

model Hero {
  id        String   @id @default(cuid())
  name      String
  level     Int      @default(1)
  element   String
  bond      Float    @default(0.5)
  account   Account  @relation(fields: [accountId], references: [id])
  accountId String
  creat     Creat?
  inventory InventoryItem[]
  fragments CrownFragment[]
  progress  Progress?
  matches   MatchHistory[]
}

model Creat {
  id     String @id @default(cuid())
  species String
  element String
  stage  String
  hero   Hero   @relation(fields: [heroId], references: [id])
  heroId String
}

model InventoryItem {
  id     String @id @default(cuid())
  name   String
  type   String
  hero   Hero   @relation(fields: [heroId], references: [id])
  heroId String
}

model CrownFragment {
  id     String @id @default(cuid())
  metal  String
  gem    String?
  shards Int
  hero   Hero   @relation(fields: [heroId], references: [id])
  heroId String
}

model Progress {
  id          String @id @default(cuid())
  district01  Boolean @default(false)
  hero        Hero   @relation(fields: [heroId], references: [id])
  heroId      String
}

model MatchHistory {
  id     String @id @default(cuid())
  result String
  hero   Hero   @relation(fields: [heroId], references: [id])
  heroId String
}
