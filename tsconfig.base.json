{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@game/shared": ["./packages/shared/src/index.ts"],
      "@game/shared/*": ["./packages/shared/src/*"]
    }
  }
}
